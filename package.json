{
  "name": "webhookforge",
  "version": "1.0.3",
  "description": "A webhook relay and debugger",
  "main": "dist/server.js",
  "bin": {
    "webhookforge": "./dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js listen",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start:prod": "node dist/cli.js listen",
    "postinstall": "npx prisma generate"
  },
  "keywords": [
    "webhook",
    "relay",
    "debugger"
  ],
  "author": "Parth Verma",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "public",
    "prisma"
  ]
}